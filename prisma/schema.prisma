generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  cashier
  admin
}

enum ProductStatus {
  draft
  active
  archived
}

enum InventoryReason {
  web_order
  pos_sale
  restock
  adjustment
  initial_stock
}

enum InventorySource {
  website
  pos
  admin
}

enum OrderStatus {
  pending
  confirmed
  packed
  shipped
  delivered
  cancelled
}

enum WebPaymentMethod {
  qr
}

enum OrderPaymentStatus {
  unpaid
  paid
  failed
}

enum PaymentStatus {
  awaiting_proof
  pending_verification
  success
  failed
}

enum PosPaymentMethod {
  cash
  qr
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  emailVerified    Boolean        @default(false)
  image            String?
  phone            String?
  role             UserRole       @default(customer)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  accounts         Account[]
  addresses        Address[]
  carts            Cart[]
  wishlistItems    WishlistItem[]
  orders           Order[]
  verifiedPayments Payment[]      @relation("PaymentVerifier")
  posSales         PosSale[]      @relation("StaffSales")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String
  fullAddress String  @db.Text
  city        String
  phone       String
  isDefault   Boolean
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String           @id @default(cuid())
  categoryId  String
  name        String
  slug        String           @unique
  description String           @db.Text
  images      Json
  status      ProductStatus
  createdAt   DateTime         @default(now())
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id            String         @id @default(cuid())
  productId     String
  sku           String         @unique
  size          String
  color         String
  price         Decimal        @db.Decimal(12, 2)
  stockQty      Int
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  posSaleItems  PosSaleItem[]

  @@index([productId])
  @@map("product_variants")
}

model InventoryLog {
  id          String          @id @default(cuid())
  variantId   String
  changeQty   Int
  reason      InventoryReason
  source      InventorySource
  referenceId String
  createdAt   DateTime        @default(now())
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@index([referenceId])
  @@index([createdAt])
  @@map("inventory_logs")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  qty       Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String         @id @default(cuid())
  userId    String
  variantId String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([userId, variantId])
  @@index([variantId])
  @@map("wishlist_items")
}

model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  userId            String?
  guestSessionId    String?
  status            OrderStatus
  subtotal          Decimal            @db.Decimal(12, 2)
  shippingFee       Decimal            @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  paymentMethod     WebPaymentMethod
  paymentStatus     OrderPaymentStatus
  shippingAddressId String?
  guestName         String?
  guestPhone        String?
  guestFullAddress  String?            @db.Text
  guestCity         String?
  trackingRef       String?
  createdAt         DateTime           @default(now())
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress   Address?           @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]

  @@index([userId])
  @@index([guestSessionId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  variantId       String
  productName     String
  productImageUrl String?
  variantSku      String
  variantSize     String
  variantColor    String
  qty             Int
  price           Decimal        @db.Decimal(12, 2)
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id            String           @id @default(cuid())
  orderId       String
  method        WebPaymentMethod
  screenshotUrl String?
  status        PaymentStatus
  amount        Decimal          @db.Decimal(12, 2)
  verifiedBy    String?
  verifiedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifier      User?            @relation("PaymentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([verifiedBy])
  @@map("payments")
}

model PosSale {
  id            String           @id @default(cuid())
  saleNumber    String           @unique
  staffId       String
  clientSaleId  String?
  cashierName   String
  subtotal      Decimal          @db.Decimal(12, 2)
  total         Decimal          @db.Decimal(12, 2)
  paymentMethod PosPaymentMethod
  needsReview   Boolean          @default(false)
  createdAt     DateTime         @default(now())
  staff         User             @relation("StaffSales", fields: [staffId], references: [id], onDelete: Restrict)
  items         PosSaleItem[]

  @@unique([staffId, clientSaleId])
  @@index([staffId])
  @@index([needsReview])
  @@index([createdAt])
  @@map("pos_sales")
}

model PosSaleItem {
  id           String         @id @default(cuid())
  saleId       String
  variantId    String
  productName  String
  variantSku   String
  variantSize  String
  variantColor String
  qty          Int
  price        Decimal        @db.Decimal(12, 2)
  sale         PosSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([saleId, variantId])
  @@index([variantId])
  @@map("pos_sale_items")
}
