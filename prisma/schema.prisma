generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  cashier
  admin
}

enum ProductStatus {
  draft
  active
  archived
}

enum InventoryReason {
  web_order
  pos_sale
  restock
  adjustment
  initial_stock
}

enum InventorySource {
  website
  pos
  admin
}

enum OrderStatus {
  pending
  confirmed
  packed
  shipped
  delivered
  cancelled
}

enum WebPaymentMethod {
  qr
  cod
}

enum OrderPaymentStatus {
  unpaid
  paid
  failed
}

enum PaymentStatus {
  awaiting_proof
  pending_verification
  success
  failed
}

enum PosPaymentMethod {
  cash
  qr
}

// Refunds are completed manually by staff (there is no payment-provider payout API).
enum RefundStatus {
  pending
  completed
}

enum PaymentQrConfigurationEventType {
  activated
  deactivated
}

enum PreferredCalendar {
  AD
  BS
}

enum CustomerProfileState {
  active
  legacy_unlinked
  reconciliation_required
}

enum MembershipSignupStatus {
  pending_verification
  linked
  conflict
}

enum MembershipAccrualSource {
  pos_sale
  web_order
}

enum EmailOutboxStatus {
  pending
  queued
  sending
  sent
  failed
  expired
}

enum EmailKind {
  auth_verification
  auth_password_reset
  pos_receipt
  web_order_confirmation
  web_payment_receipt
  web_delivery_receipt
}

enum ShipmentCarrier {
  nepal_can_move
}

enum ShipmentBookingStatus {
  pending
  booked
  failed
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  emailVerified    Boolean        @default(false)
  image            String?
  phone            String?
  pendingMembershipProfile String?
  role             UserRole       @default(customer)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  accounts         Account[]
  addresses        Address[]
  carts            Cart[]
  wishlistItems    WishlistItem[]
  orders           Order[]
  verifiedPayments Payment[]      @relation("PaymentVerifier")
  posSales         PosSale[]      @relation("StaffSales")
  uploadedQrConfigurations PaymentQrConfiguration[] @relation("QrConfigurationUploader")
  activatedQrConfigurations PaymentQrConfiguration[] @relation("QrConfigurationActivator")
  qrConfigurationEvents PaymentQrConfigurationEvent[]
  customerProfile CustomerProfile?
  membershipSignupClaim MembershipSignupClaim?
  membershipTierAudits MembershipTierAudit[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String
  fullAddress String  @db.Text
  city        String
  phone       String
  isDefault   Boolean
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String           @id @default(cuid())
  categoryId  String
  name        String
  slug        String           @unique
  description String           @db.Text
  images      Json
  status      ProductStatus
  createdAt   DateTime         @default(now())
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  media       ProductImage[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id               String   @id @default(cuid())
  productId        String
  objectKey        String?  @unique
  publicUrl        String
  detectedMimeType String?
  byteSize         Int?
  sortOrder        Int
  isLegacy         Boolean  @default(false)
  createdAt        DateTime @default(now())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String         @id @default(cuid())
  productId     String
  sku           String         @unique
  size          String
  color         String
  price         Decimal        @db.Decimal(12, 2)
  stockQty      Int
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  posSaleItems  PosSaleItem[]

  @@index([productId])
  @@map("product_variants")
}

model InventoryLog {
  id          String          @id @default(cuid())
  variantId   String
  changeQty   Int
  reason      InventoryReason
  source      InventorySource
  referenceId String
  createdAt   DateTime        @default(now())
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@index([referenceId])
  @@index([createdAt])
  @@map("inventory_logs")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  qty       Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String         @id @default(cuid())
  userId    String
  variantId String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([userId, variantId])
  @@index([variantId])
  @@map("wishlist_items")
}

model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  userId            String?
  customerProfileId String?
  guestSessionId    String?
  status            OrderStatus
  subtotal          Decimal            @db.Decimal(12, 2)
  shippingFee       Decimal            @db.Decimal(12, 2)
  shippingDeliveryFee Decimal          @default(0) @db.Decimal(12, 2)
  shippingPickupFee Decimal            @default(0) @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  advancePaymentAmount Decimal         @default(0) @db.Decimal(12, 2)
  codCollectionAmount Decimal          @default(0) @db.Decimal(12, 2)
  codMerchandiseAdvancePercent Decimal @default(0) @db.Decimal(5, 2)
  merchandiseDiscount Decimal          @default(0) @db.Decimal(12, 2)
  membershipDiscountPercent Decimal    @default(0) @db.Decimal(5, 2)
  membershipTierSnapshot Json?
  paymentMethod     WebPaymentMethod
  paymentStatus     OrderPaymentStatus
  refundStatus      RefundStatus?
  refundAmount      Decimal?           @db.Decimal(12, 2)
  refundReason      String?            @db.Text
  refundRequestedAt DateTime?
  refundCompletedAt DateTime?
  refundReference   String?
  shippingAddressId String?
  guestName         String?
  guestEmail        String?
  guestPhone        String?
  guestFullAddress  String?            @db.Text
  guestCity         String?
  trackingRef       String?
  createdAt         DateTime           @default(now())
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerProfile   CustomerProfile?   @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  shippingAddress   Address?           @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  membershipAccrual MembershipAccrual?
  shipment         Shipment?

  @@index([userId])
  @@index([customerProfileId])
  @@index([guestSessionId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  variantId       String
  productName     String
  productImageUrl String?
  variantSku      String
  variantSize     String
  variantColor    String
  qty             Int
  price           Decimal        @db.Decimal(12, 2)
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id            String           @id @default(cuid())
  orderId       String
  method        WebPaymentMethod
  screenshotUrl String?
  screenshotObjectKey String? @unique
  screenshotMimeType String?
  screenshotSize Int?
  qrConfigurationId String?
  status        PaymentStatus
  amount        Decimal          @db.Decimal(12, 2)
  verifiedBy    String?
  verifiedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifier      User?            @relation("PaymentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  qrConfiguration PaymentQrConfiguration? @relation(fields: [qrConfigurationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([verifiedBy])
  @@index([qrConfigurationId])
  @@map("payments")
}

model Shipment {
  id                 String                @id @default(cuid())
  orderId            String                @unique
  carrier            ShipmentCarrier       @default(nepal_can_move)
  carrierOrderId     String?               @unique
  bookingStatus      ShipmentBookingStatus @default(pending)
  pickupBranch       String
  destinationBranch  String
  deliveryType       String                @default("Door2Door")
  packageDescription String?               @db.Text
  weightGrams        Int?
  carrierCharge      Decimal?              @db.Decimal(12, 2)
  collectionAmount   Decimal                @default(0) @db.Decimal(12, 2)
  carrierStatus      String?
  carrierStatusAt    DateTime?
  bookingError       String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events             ShipmentEvent[]

  @@index([bookingStatus])
  @@index([carrierStatusAt])
  @@map("shipments")
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  event       String
  status      String
  occurredAt  DateTime?
  receivedAt  DateTime @default(now())
  payloadHash String
  rawPayload  Json
  isTest      Boolean  @default(false)
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, payloadHash])
  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model PaymentQrConfiguration {
  id                String   @id @default(cuid())
  objectKey         String   @unique
  publicUrl         String
  detectedMimeType  String
  byteSize          Int
  providerName      String?
  accountName       String?
  accountIdentifier String?
  instructions      String?
  codMerchandiseAdvancePercent Decimal @default(0) @db.Decimal(5, 2)
  isActive          Boolean  @default(false)
  uploadedById      String
  activatedById     String?
  createdAt         DateTime @default(now())
  activatedAt       DateTime?
  uploadedBy        User     @relation("QrConfigurationUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  activatedBy       User?    @relation("QrConfigurationActivator", fields: [activatedById], references: [id], onDelete: SetNull)
  events            PaymentQrConfigurationEvent[]
  payments          Payment[]

  @@index([isActive])
  @@index([createdAt])
  @@map("payment_qr_configurations")
}

model PaymentQrConfigurationEvent {
  id              String                          @id @default(cuid())
  configurationId String
  actorId         String
  type            PaymentQrConfigurationEventType
  createdAt       DateTime                        @default(now())
  configuration   PaymentQrConfiguration          @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  actor           User                            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([configurationId, createdAt])
  @@map("payment_qr_configuration_events")
}

model PosSale {
  id            String           @id @default(cuid())
  saleNumber    String           @unique
  staffId       String
  customerProfileId String?
  clientSaleId  String?
  cashierName   String
  subtotal      Decimal          @db.Decimal(12, 2)
  merchandiseDiscount Decimal    @default(0) @db.Decimal(12, 2)
  membershipDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  membershipTierSnapshot Json?
  total         Decimal          @db.Decimal(12, 2)
  paymentMethod PosPaymentMethod
  needsReview   Boolean          @default(false)
  createdAt     DateTime         @default(now())
  staff         User             @relation("StaffSales", fields: [staffId], references: [id], onDelete: Restrict)
  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  items         PosSaleItem[]
  membershipAccrual MembershipAccrual?

  @@unique([staffId, clientSaleId])
  @@index([staffId])
  @@index([customerProfileId])
  @@index([needsReview])
  @@index([createdAt])
  @@map("pos_sales")
}

model PosSaleItem {
  id           String         @id @default(cuid())
  saleId       String
  variantId    String
  productName  String
  productImageUrl String?
  variantSku   String
  variantSize  String
  variantColor String
  qty          Int
  price        Decimal        @db.Decimal(12, 2)
  sale         PosSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([saleId, variantId])
  @@index([variantId])
  @@map("pos_sale_items")
}

model CustomerProfile {
  id                  String               @id @default(cuid())
  userId              String?              @unique
  fullName            String
  normalizedPhone     String?
  normalizedEmail     String?
  birthDate           DateTime?            @db.Date
  preferredCalendar   PreferredCalendar?
  bsBirthMonth        Int?
  bsBirthDay          Int?
  state               CustomerProfileState @default(active)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders              Order[]
  posSales            PosSale[]
  membershipYears     CustomerMembershipYear[]
  membershipAccruals  MembershipAccrual[]

  @@unique([normalizedPhone])
  @@unique([normalizedEmail])
  @@index([state])
  @@index([preferredCalendar, bsBirthMonth, bsBirthDay])
  @@index([birthDate])
  @@map("customer_profiles")
}

model MembershipSignupClaim {
  id                  String                 @id @default(cuid())
  userId              String                 @unique
  fullName            String
  normalizedPhone     String
  normalizedEmail     String
  birthDate           DateTime               @db.Date
  preferredCalendar   PreferredCalendar
  bsBirthMonth        Int?
  bsBirthDay          Int?
  status              MembershipSignupStatus @default(pending_verification)
  conflictReason      String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("membership_signup_claims")
}

model MembershipTier {
  id                    String   @id @default(cuid())
  name                  String   @unique
  threshold              Decimal  @db.Decimal(12, 2)
  discountPercent        Decimal  @db.Decimal(5, 2)
  benefits               String   @db.Text
  birthdayGiftDescription String  @db.Text
  rank                  Int      @unique
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  versions              MembershipTierVersion[]
  audits                MembershipTierAudit[]

  @@index([isActive, threshold])
  @@map("membership_tiers")
}

model MembershipTierVersion {
  id                    String   @id @default(cuid())
  tierId                String
  version               Int
  name                  String
  threshold              Decimal  @db.Decimal(12, 2)
  discountPercent        Decimal  @db.Decimal(5, 2)
  benefits               String   @db.Text
  birthdayGiftDescription String  @db.Text
  rank                  Int
  isActive              Boolean
  createdAt             DateTime @default(now())
  tier                  MembershipTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  membershipYears       CustomerMembershipYear[]

  @@unique([tierId, version])
  @@index([tierId, createdAt])
  @@map("membership_tier_versions")
}

model MembershipTierAudit {
  id        String   @id @default(cuid())
  tierId    String
  actorId   String?
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  tier      MembershipTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  actor     User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tierId, createdAt])
  @@map("membership_tier_audits")
}

model CustomerMembershipYear {
  id                    String   @id @default(cuid())
  customerProfileId     String
  year                  Int
  eligibleNetSpend      Decimal  @default(0) @db.Decimal(12, 2)
  activeTierId          String?
  activeTierVersionId   String?
  activatedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  customerProfile       CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  activeTierVersion     MembershipTierVersion? @relation(fields: [activeTierVersionId], references: [id], onDelete: SetNull)
  accruals              MembershipAccrual[]

  @@unique([customerProfileId, year])
  @@index([year, activeTierId])
  @@map("customer_membership_years")
}

model MembershipAccrual {
  id                    String                  @id @default(cuid())
  customerProfileId     String
  membershipYearId      String
  source                MembershipAccrualSource
  posSaleId             String?                 @unique
  orderId               String?                 @unique
  netMerchandiseAmount  Decimal                 @db.Decimal(12, 2)
  tierBeforeSnapshot    Json?
  tierAfterSnapshot     Json?
  createdAt             DateTime                @default(now())
  customerProfile       CustomerProfile         @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  membershipYear        CustomerMembershipYear  @relation(fields: [membershipYearId], references: [id], onDelete: Restrict)
  posSale               PosSale?                @relation(fields: [posSaleId], references: [id], onDelete: Restrict)
  order                 Order?                  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([customerProfileId, createdAt])
  @@map("membership_accruals")
}

model EmailOutbox {
  id               String            @id @default(cuid())
  kind             EmailKind
  recipientEmail   String
  deduplicationKey String            @unique
  payload          Json?
  encryptedPayload String?           @db.Text
  status           EmailOutboxStatus @default(pending)
  attempts         Int               @default(0)
  providerMessageId String?
  lastErrorCode    String?
  availableAt      DateTime          @default(now())
  sentAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, availableAt])
  @@map("email_outbox")
}
