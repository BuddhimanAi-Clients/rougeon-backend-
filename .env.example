# Application
NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000
TRUST_PROXY=false

# Comma-separated frontend origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:5173

# PostgreSQL runs on host port 5433 in docker-compose.yml
DATABASE_URL=postgresql://rogueon:rogueon123@localhost:5433/rogueon_dev?schema=public

# Tests must use an isolated schema; integration tests reject unsafe URLs
TEST_DATABASE_URL=postgresql://rogueon:rogueon123@localhost:5433/rogueon_dev?schema=admin_api_test

# Generate a unique value with at least 32 characters; never reuse this example
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Website checkout uses one fixed shipping fee in v1
SHIPPING_FEE=150.00

# Cloudflare R2 media storage. Use a production custom domain for public product/QR media.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=rogueon-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Transactional authentication email
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=no-reply@example.com
WEB_APP_URL=http://localhost:5173

# Public store details printed on POS receipts
STORE_NAME=ROGUEON
STORE_ADDRESS=replace-with-public-store-address

# Logging
LOG_LEVEL=debug
