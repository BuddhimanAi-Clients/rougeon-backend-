# ROGUEON backend environment
# Copy to .env and fill in. Never commit the real .env.
#
#   1. REQUIRED              - the server will not start without these
#   2. REQUIRED IN PRODUCTION - the server starts without them, but the named
#                               feature is switched off or fails
#   3. OPTIONAL              - have sensible defaults; set only to change them

# =============================================================================
# 1. REQUIRED
# =============================================================================

# Public URL of this backend
SERVER_URL=http://localhost:3000

# Comma-separated frontend origins (web, POS, admin) allowed to send cookies
CORS_ORIGINS=http://localhost:5173

# PostgreSQL. docker-compose.yml exposes it on host port 5433
DATABASE_URL=postgresql://rogueon:rogueon123@localhost:5433/rogueon_dev?schema=public

# At least 32 random characters. Generate a fresh one; never reuse this example
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Store details printed on receipts and emails
STORE_NAME=ROGUEON
STORE_ADDRESS=replace-with-public-store-address

# =============================================================================
# 2. REQUIRED IN PRODUCTION
# =============================================================================

# --- Image uploads (Cloudflare R2): product, category, QR and payment-proof
# --- images. All five are needed, otherwise uploads are unavailable.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=rogueon-media
R2_PUBLIC_BASE_URL=https://media.example.com

# --- Email (Resend): sign-up verification, password reset, order emails.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=no-reply@example.com
# Storefront URL used for links inside emails
WEB_APP_URL=http://localhost:5173
# Queue for the email worker (npm run worker:email)
REDIS_URL=redis://:rogueonredis123@localhost:6379
# At least 32 random characters; encrypts sign-in links waiting in the queue
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-a-random-key-of-at-least-32-characters

# --- Nepal Can Move courier booking and tracking. Delivery prices work
# --- without these; booking a parcel and status updates do not.
NCM_API_TOKEN=replace-with-vendor-token
# At least 32 random characters. The webhook URL to give NCM is
# <SERVER_URL>/api/v1/integrations/ncm/webhook/<this secret>
NCM_WEBHOOK_SECRET=replace-with-a-random-webhook-path-secret-of-at-least-32-characters

# Set to true when running behind a proxy/load balancer (Render, Railway, Nginx)
TRUST_PROXY=false

# =============================================================================
# 3. OPTIONAL (defaults shown)
# =============================================================================

# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=debug
# BUSINESS_TIMEZONE=Asia/Kathmandu

# --- Delivery pricing
# ncm  = live Nepal Can Move rate for the customer's delivery area
# flat = every order pays SHIPPING_FEE (fallback if NCM pricing is down)
# SHIPPING_RATE_MODE=ncm
# NCM branch parcels are picked up from; rates are calculated from here
# NCM_DEFAULT_PICKUP_BRANCH=CHABAHIL
# Store collection charge added on top of the courier rate. Customers see
# only the combined amount as "Delivery".
# NCM_PICKUP_FEE=15.00
# Used only when SHIPPING_RATE_MODE=flat
# SHIPPING_FEE=150.00
# NCM_API_BASE_URL=https://portal.nepalcanmove.com

# --- Email in development: "console" prints emails to the log instead of
# --- sending. Use "resend" only to test real sending locally. Production
# --- always sends.
# EMAIL_DELIVERY_MODE=console

# --- Extra lines on receipts and emails
# STORE_PHONE="+977-98XXXXXXXX"
# STORE_PAN="123456789"
# RECEIPT_FOOTER_NOTE="Exchange within 7 days with this receipt. No cash refunds."

# --- Tests only (npm test). Must point at a schema or database with "test"
# --- in its name; it is wiped on every run.
TEST_DATABASE_URL=postgresql://rogueon:rogueon123@localhost:5433/rogueon_dev?schema=admin_api_test
